{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scanty-fun",
  "main": "src/index.js",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scanty_fun_db",
      "database_id": "4894e3f0-1013-4120-b841-ce7fb8b11c90",
      "migrations_dir": "migrations"
    }
  ]
}

{
  // ...
  "vars": {
    "ADMIN_PASSWORD": "SCANTY-MD@123",
    "YOUTUBE_API_KEY": "AIzaSyAJav46JSi9HXZTPwqgTg593y30A5NiRNs"
  },
  // ...
}
